# Copy to .env.local and fill in. Never commit real values.

# Mynt's MCP endpoint. Sign-in uses the OAuth metadata Mynt publishes there.
MYNT_MCP_URL=https://mynt.example.com/mcp

# This app's public URL (OAuth redirects go to $APP_URL/api/auth/callback).
APP_URL=http://localhost:3000

# Where build previews may be framed from: space-separated https origins, wildcards allowed
# (https://*.preview.example). Unset means no preview can be shown.
PREVIEW_FRAME_SRC=

# Scopes to ask for (defaults to the scopes Mynt advertises).
# MYNT_OAUTH_SCOPE=openid profile email

# Session store. Leave these unset locally to keep sessions in memory. On Vercel, connecting a
# Redis database to the project sets the first two; the Upstash names work too.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 32 random bytes, base64-encoded, encrypting sessions (OAuth tokens included) in the store.
# Required with Redis. Make one with: openssl rand -base64 32
# SESSION_ENCRYPTION_KEY=
# Earlier keys, comma-separated, that still decrypt sessions sealed before a rotation.
# SESSION_ENCRYPTION_KEYS_OLD=

# Off Vercel only: the header your proxy always sets to the caller's address, for the sign-in
# rate limit (on Vercel, its own x-vercel-forwarded-for is used).
# TRUSTED_PROXY_HEADER=x-real-ip

# Allow the in-memory store with NODE_ENV=production (one local process only; never on Vercel).
# SESSION_STORE=memory
