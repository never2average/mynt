{
  "region": "US",
  "key": "onramp_quote",
  "name": "Mynt Ramp: add dollars quote",
  "category": "ramp",
  "moves_money": false,
  "description": "A firm price for a customer adding US dollars from their bank account through the Mynt Ramp: amount_usd from the bank, fee_usd, and total_usd added to their dollar balance (amount less fee). The price holds until expires_at; the customer accepts it with onramp_transfer. The device sees dollars only. Underneath, the licensed ramp partner settles the dollars as USDC on Solana with the product's provider: settlement_asset, settlement_network and settlement_amount are partner-side and go only to the innovator, never to the device.",
  "input_schema": {
    "type": "object",
    "required": [
      "full_name",
      "bank_account_number",
      "routing_number"
    ],
    "properties": {
      "full_name": {
        "type": "string"
      },
      "bank_account_number": {
        "type": "string",
        "pattern": "^[0-9]{9,18}$"
      },
      "routing_number": {
        "type": "string",
        "pattern": "^[0-9]{9}$"
      }
    },
    "additionalProperties": false
  },
  "params_schema": {
    "type": "object",
    "required": [
      "direction",
      "amount_usd"
    ],
    "properties": {
      "direction": {
        "enum": [
          "in"
        ]
      },
      "amount_usd": {
        "type": "string",
        "pattern": "^[0-9]{1,9}(\\.[0-9]{1,2})?$"
      }
    },
    "additionalProperties": false
  },
  "params_fixture": {
    "direction": "in",
    "amount_usd": "100.00"
  },
  "output_schema": {
    "type": "object",
    "required": [
      "quote_id",
      "expires_at",
      "direction",
      "amount_usd",
      "fee_usd",
      "total_usd",
      "currency",
      "settlement_asset",
      "settlement_network",
      "settlement_amount"
    ],
    "properties": {
      "quote_id": {
        "type": "string"
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      },
      "direction": {
        "enum": [
          "in"
        ]
      },
      "amount_usd": {
        "type": "string"
      },
      "fee_usd": {
        "type": "string"
      },
      "total_usd": {
        "type": "string"
      },
      "currency": {
        "enum": [
          "USD"
        ]
      },
      "estimated_arrival": {
        "type": [
          "string",
          "null"
        ]
      },
      "settlement_asset": {
        "enum": [
          "USDC"
        ]
      },
      "settlement_network": {
        "enum": [
          "solana"
        ]
      },
      "settlement_amount": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "quote": true,
  "consent_purpose": "fiat_onramp",
  "fills": [],
  "innovator_licences": [],
  "vendor_licences": [
    "fincen_msb"
  ],
  "client_result": {
    "fields": [
      "direction",
      "amount_usd",
      "fee_usd",
      "total_usd",
      "currency",
      "estimated_arrival"
    ],
    "redirect": false
  }
}
