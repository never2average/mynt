{
  "region": "US",
  "key": "ramp_transfer",
  "name": "Mynt Ramp transfer",
  "category": "ramp",
  "description": "Accepts a ramp_quote: pulls the customer's dollars and settles the stablecoin with the product's liquidity provider (on-ramp), or takes the stablecoin and pays the customer's bank account (off-ramp). Bank transfers settle later, so it usually answers pending and finishes by callback; a returned bank transfer ends it as returned.",
  "input_schema": {
    "type": "object",
    "required": [
      "full_name",
      "bank_account_number",
      "routing_number"
    ],
    "properties": {
      "full_name": {
        "type": "string"
      },
      "bank_account_number": {
        "type": "string",
        "pattern": "^[0-9]{9,18}$"
      },
      "routing_number": {
        "type": "string",
        "pattern": "^[0-9]{9}$"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "transfer_status"
    ],
    "properties": {
      "transfer_status": {
        "enum": [
          "submitted",
          "settled",
          "failed",
          "returned"
        ]
      },
      "settlement_ref": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  },
  "accepts": "ramp_quote",
  "consent_purpose": "fiat_ramp_transfer",
  "fills": [],
  "innovator_licences": [],
  "vendor_licences": [
    "fincen_msb"
  ],
  "client_result": {
    "status": {
      "from": "transfer_status",
      "map": {
        "submitted": "pending",
        "settled": "completed",
        "failed": "failed",
        "returned": "failed"
      }
    },
    "fields": [
      "transfer_status"
    ],
    "redirect": false
  }
}
