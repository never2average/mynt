{
  "region": "IN",
  "key": "digilocker_documents",
  "name": "DigiLocker documents",
  "category": "documents",
  "description": "Fetches documents the customer holds in DigiLocker, once the customer authorises the request in DigiLocker itself, and returns the identity details on them.",
  "input_schema": {
    "type": "object",
    "required": [],
    "properties": {
      "mobile_number": {
        "type": "string",
        "pattern": "^\\+?[0-9]{10,15}$"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "full_name"
    ],
    "properties": {
      "full_name": {
        "type": "string"
      },
      "date_of_birth": {
        "type": "string",
        "format": "date"
      },
      "address": {
        "type": "string"
      },
      "pan": {
        "type": "string",
        "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$"
      },
      "aadhaar_reference": {
        "type": "string",
        "description": "Masked: never the full number"
      }
    },
    "additionalProperties": false
  },
  "consent_purpose": "document_fetch",
  "fills": [
    "full_name",
    "date_of_birth",
    "address",
    "pan",
    "aadhaar_reference"
  ],
  "innovator_licences": [],
  "vendor_licences": []
}
