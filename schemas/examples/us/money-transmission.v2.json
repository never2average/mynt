{
  "_id": "money-transmission",
  "product_name": "Money transmission (Mynt Ramp)",
  "product_type": "money_transmission",
  "descriptions": {
    "summary": "Move US dollars in from your bank account and back out to it, by bank transfer or wire, held for you in transit by a licensed money transmitter.",
    "key_features": [
      "Add dollars from your own bank account by bank transfer (ACH) or wire",
      "Send dollars back to your bank account whenever you like",
      "Your money is held in transit by a licensed money transmitter, under its state licences",
      "See the fee before you confirm: 0.5% per transfer, at least $0.50",
      "Money held in transit is not a bank deposit and isn't FDIC-insured"
    ],
    "long": "Mynt's foundational US product: money transmission, operated by the licensed partner behind the Mynt Ramp (model R1). Dollars come in from the customer's own bank account by ACH or wire and go back out the same way; between the two the licensed partner holds them in transit under its FinCEN registration and its money transmitter licence in each state it serves. Customers only ever see US dollars. Other dollar products (a dollar account, payouts) are built on this one (builds_on) instead of declaring transmission again, and can only be offered in the states this one covers. This template names no firm: the partner's firm owns it, names itself as the provider of the transmission component, and sets offered_in to the states it is licensed in. Assumptions: USD only, individuals only; the fee mirrors the Mynt Ramp sandbox's (0.5%, at least $0.50); limits are placeholders the owner sets; exemptions (such as acting as agent of the payee) are not relied on."
  },
  "owner_entity_id": null,
  "version": 1,
