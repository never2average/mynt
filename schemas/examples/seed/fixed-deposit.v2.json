  "core_algorithms": [
    {
      "_id": "onboarding_eligibility",
      "algorithm_name": "Term deposit booking eligibility",
      "description": "Requires full KYC and a resident individual; asks for PAN (or the declaration the Income-tax rules allow) on large deposits; keeps a single deposit below the bulk-deposit threshold.",
      "purpose": "eligibility",
      "repository": "models/fd-booking-eligibility",
      "version": "1.0.0",
      "decision": {
        "knockouts": [
          {
            "rule": {
              "attr": "customer.age",
              "op": "lt",
              "value": 18
            },
            "reason_code": "below_minimum_age"
          },
          {
            "rule": {
              "attr": "customer.resident",
              "op": "eq",
              "value": false
            },
            "reason_code": "non_resident"
          },
          {
            "rule": {
              "attr": "deposit.principal",
              "op": "gte",
              "value": 30000000
            },
            "reason_code": "bulk_deposit"
          }
        ]
      }
    },
    {
      "_id": "fd_interest",
      "algorithm_name": "Term deposit interest, payout and premature closure",
      "description": "Quarterly compounding for the cumulative option; quarterly payout, or monthly at the discounted equivalent of the quarterly rate; on premature closure recomputes at the rate for the period actually run less the disclosed penalty, recovering any interest already paid above it.",
      "purpose": "interest_calculation",
      "repository": "models/fd-interest",
      "version": "1.0.0"
    },
    {
      "_id": "tds_on_interest",
      "algorithm_name": "Tax deducted at source on interest",
      "description": "Aggregates the depositor's interest across deposits in the financial year and deducts tax at source above the statutory threshold (higher for senior citizens), unless a valid declaration is on file.",
      "purpose": "other",
      "repository": "models/fd-tds",
      "version": "1.0.0"
    }
  ],
