        "max": 3650,
        "step": 1
      },
      "set_by": [
        "template",
        "jurisdiction_variant",
        "customer"
      ],
      "negotiable": "customer_choice",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "deposit_rate",
      "label": "Interest rate (card rate for the chosen term)",
      "type": "rate",
      "unit": "pct_pa",
      "default": 6.5,
      "range": {
        "min": 2.5,
        "max": 9
      },
      "set_by": [
        "template",
        "jurisdiction_variant",
        "operations"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      },
      "effective_dated": true
    },
    {
      "_id": "senior_spread_bps",
      "label": "Senior citizen additional rate",
      "type": "integer",
      "unit": "bps",
      "default": 0,
      "range": {
        "min": 0,
        "max": 100
      },
      "set_by": [
        "template",
        "segment_override"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "payout_option",
      "label": "Interest payout",
      "type": "enum",
      "default": "cumulative",
      "allowed": [
        "cumulative",
        "quarterly",
        "monthly"
      ],
      "set_by": [
        "template",
        "customer"
      ],
      "negotiable": "customer_choice",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "payout_cycle",
      "label": "Payout cycle",
      "type": "cycle",
      "derived": "payout_option == 'monthly' ? 'P1M' : 'P3M'",
      "set_by": [
        "template"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "premature_penalty_bps",
      "label": "Rate reduction on premature withdrawal",
      "type": "integer",
      "unit": "bps",
      "default": 100,
      "range": {
        "min": 0,
        "max": 200
      },
      "set_by": [
        "template",
        "jurisdiction_variant"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "premature_withdrawal_assured_upto",
      "label": "Premature withdrawal assured for individuals' deposits up to",
      "type": "money",
      "currency": "INR",
      "default": 10000000,
      "set_by": [
        "jurisdiction_variant"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "maturity_instruction",
      "label": "At maturity",
      "type": "enum",
      "default": "pay_out",
      "allowed": [
        "pay_out",
        "renew_principal",
        "renew_principal_and_interest"
      ],
      "set_by": [
        "template",
        "customer"
      ],
      "negotiable": "customer_choice",
      "post_issue": {
        "rule": "customer_dated_change",
        "notice": "P1D",
        "event": "maturity_instruction_changed"
      }
    },
    {
      "_id": "maturity_date",
      "label": "Maturity date",
      "type": "date",
      "derived": "add_days(value_date, tenor_days)",
      "set_by": [
        "template"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    }
