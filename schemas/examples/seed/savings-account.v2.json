      ]
    },
    {
      "_id": "card_fee_charged",
      "sequence": 10,
      "trigger": "scheduled",
      "primitives": [
        "quantity_change"
      ]
    },
    {
      "_id": "min_balance_shortfall_assessed",
      "sequence": 10,
      "trigger": "condition",
      "when": [
        {
          "expr": "average_monthly_balance < min_average_balance"
        }
      ]
    },
    {
      "_id": "nominee_updated",
      "sequence": 11,
