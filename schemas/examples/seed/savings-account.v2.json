  "core_algorithms": [
    {
      "_id": "onboarding_eligibility",
      "algorithm_name": "Savings account onboarding eligibility",
      "description": "Knocks out applicants who can't hold a resident savings account: under 18 (minors open through a guardian, not modelled here), non-residents (who hold NRE/NRO accounts under FEMA instead), and names matching the sanctions lists the KYC directions require screening against.",
      "purpose": "eligibility",
      "repository": "models/sb-onboarding-eligibility",
      "version": "1.0.0",
      "decision": {
        "knockouts": [
          {
            "rule": {
              "attr": "customer.age",
              "op": "lt",
              "value": 18
            },
            "reason_code": "below_minimum_age"
          },
          {
            "rule": {
              "attr": "customer.resident",
              "op": "eq",
              "value": false
            },
            "reason_code": "non_resident"
          },
          {
            "rule": {
              "attr": "screening.sanctions_match",
              "op": "eq",
              "value": true
            },
            "reason_code": "sanctions_match"
          }
        ]
      }
    },
    {
      "_id": "sb_interest",
      "algorithm_name": "Savings interest on the daily closing balance",
      "description": "Accrues interest every day on the closing balance, slab-wise (one uniform rate up to the slab threshold, a different rate on the part above), and credits it at quarterly rests. Interest keeps accruing while an account is inoperative.",
      "purpose": "interest_calculation",
      "repository": "models/sb-interest",
      "version": "1.0.0"
    },
    {
      "_id": "min_balance_charge",
      "algorithm_name": "Minimum-balance shortfall charge",
      "description": "Measures the average monthly balance against the required minimum; on a shortfall, notifies the customer first and charges only if the balance isn't restored within one month. The charge is proportionate to the shortfall, capped, never takes the balance below zero and is never levied on an inoperative account.",
      "purpose": "other",
      "repository": "models/sb-min-balance-charge",
      "version": "1.0.0"
    },
    {
      "_id": "txn_monitoring",
      "algorithm_name": "Transaction monitoring",
      "description": "Screens outgoing transfers in real time (new-account velocity, device and beneficiary risk) and reviews activity after the event for suspicious patterns to report to the Financial Intelligence Unit.",
      "purpose": "fraud_screening",
      "repository": "models/sb-txn-monitoring",
      "version": "1.0.0"
    }
  ],
  "risk_models": [],
