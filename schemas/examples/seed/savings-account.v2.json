      "_id": "reactivated",
      "sequence": 12,
      "trigger": "customer",
      "primitives": [
        "terms_change"
      ]
    },
    {
      "_id": "account_closed",
      "actus": "TD",
      "sequence": 16,
      "trigger": "customer",
      "primitives": [
        "terms_change",
        "quantity_change",
        "transfer"
      ],
      "edition": "stored"
    },
    {
      "_id": "payment_instruments_cancelled",
      "sequence": 16,
      "trigger": "linked",
      "primitives": [
        "terms_change"
      ]
    }
  ],
  "invariants": [
    {
      "_id": "uniform_rate_below_slab",
      "expr": "rates.savings_interest.tiers[0].max == slab_threshold",
      "message": "One uniform rate up to the slab threshold",
      "applies_at": [
        "design",
        "publish"
      ]
    },
    {
      "_id": "atm_fee_within_cap",
      "expr": "atm_fee_per_txn <= 23",
      "message": "RBI caps the charge per ATM transaction beyond the free ones",
      "applies_at": [
        "design",
        "publish",
        "post_issue_change"
      ]
    },
    {
      "_id": "charges_never_overdraw",
      "expr": "account.balance - min_balance_shortfall.charge >= 0",
      "message": "A minimum-balance charge never takes the balance below zero",
      "applies_at": [
        "origination",
        "post_issue_change"
      ]
    }
  ],
