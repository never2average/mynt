        "escalate_to": "rbi_integrated_ombudsman",
        "escalate_if_unresolved_after": "P30D",
        "charge_change_notice": "P1M"
      }
    }
  ],
  "lifecycle_events": [
    {
      "_id": "account_opened",
      "sequence": 1,
      "trigger": "customer",
      "primitives": [
        "contract_formation",
        "execution"
      ],
      "edition": "latest"
    },
    {
      "_id": "funds_received",
      "sequence": 4,
      "trigger": "partner",
      "primitives": [
        "quantity_change",
        "transfer"
      ]
    },
    {
      "_id": "transfer_out",
      "sequence": 5,
      "trigger": "customer",
      "primitives": [
        "transfer",
        "quantity_change"
      ]
    },
    {
      "_id": "atm_withdrawal",
      "sequence": 5,
      "trigger": "partner",
      "primitives": [
        "transfer",
        "quantity_change"
      ]
    },
