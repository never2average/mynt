        "charges_while_inoperative": "none",
        "reactivation": "on a KYC update, free of charge, at any branch or by video KYC",
        "unclaimed_after": {
          "$term": "unclaimed_after"
        },
        "unclaimed_action": "transfer_to_depositor_education_and_awareness_fund",
        "claimable_after_transfer": true
