  "rates": [
    {
      "_id": "savings_interest",
      "kind": "deposit",
      "rate_type": "variable",
      "day_count": "actual_365_fixed",
      "compounding": "P3M",
      "application": "periodic",
      "method": "daily_closing_balance",
      "tiers": [
        {
          "unit": "amount",
          "min": 0,
          "max": 100000,
          "rate": {
            "$term": "rate_upto_slab"
          },
          "application": "per_tier"
        },
        {
          "unit": "amount",
          "min": 100000,
          "rate": {
            "$term": "rate_above_slab"
          },
          "application": "per_tier"
        }
      ]
    }
  ],
  "fees": [
    {
      "_id": "min_balance_shortfall",
      "type": "EVENT",
      "method": "variable",
      "cap": {
        "$term": "shortfall_charge_cap"
      },
      "cap_period": "P1M",
      "payer": "customer",
      "tax": [
        "in_gst"
      ],
      "waivers": [
        {
          "expr": "days_since_shortfall_notice < 30"
        },
        {
          "attr": "account.status",
          "op": "eq",
          "value": "inoperative"
        },
        {
          "expr": "charge > account.balance"
        }
      ]
    },
    {
      "_id": "atm_beyond_free",
      "type": "TRANSACTION",
      "method": "fixed",
      "amount": {
        "$term": "atm_fee_per_txn"
      },
      "payer": "customer",
      "tax": [
        "in_gst"
      ],
      "waivers": [
        {
          "expr": "atm_transactions_this_month <= free_allowance(atm.owner, atm.centre)"
        }
      ]
    },
    {
      "_id": "debit_card_annual",
      "type": "PERIODIC",
      "method": "fixed",
      "amount": {
        "$term": "debit_card_annual_fee"
      },
      "payer": "customer",
      "tax": [
        "in_gst"
      ]
    }
  ],
  "limits": [
    {
      "_id": "minimum_balance",
