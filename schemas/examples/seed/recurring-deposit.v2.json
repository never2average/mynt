  "core_algorithms": [
    {
      "_id": "onboarding_eligibility",
      "algorithm_name": "Recurring deposit opening eligibility",
      "description": "Requires full KYC, a resident individual and a registered debit instruction on an account in the customer's own name before the first instalment.",
      "purpose": "eligibility",
      "repository": "models/rd-opening-eligibility",
      "version": "1.0.0",
      "decision": {
        "knockouts": [
          {
            "rule": {
              "attr": "customer.age",
              "op": "lt",
              "value": 18
            },
            "reason_code": "below_minimum_age"
          },
          {
            "rule": {
              "attr": "customer.resident",
              "op": "eq",
              "value": false
            },
            "reason_code": "non_resident"
          },
          {
            "rule": {
              "attr": "mandate.account_holder_matches",
              "op": "eq",
              "value": false
            },
            "reason_code": "mandate_account_not_customers"
          }
        ]
      }
    },
    {
      "_id": "rd_interest",
      "algorithm_name": "Recurring deposit interest and premature-closure calculator",
      "description": "Quarterly compounding on each instalment from its credit date; recomputes at the rate for the period run less the penalty on premature closure; charges late instalments per month of delay.",
      "purpose": "interest_calculation",
      "repository": "models/rd-interest",
      "version": "1.0.0"
    }
  ],
