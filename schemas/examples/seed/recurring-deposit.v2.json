      "actus": "MD",
      "sequence": 19,
      "trigger": "scheduled",
      "primitives": [
        "quantity_change",
        "transfer"
      ]
    },
    {
      "_id": "mandate_cancelled",
      "sequence": 19,
      "trigger": "linked",
      "primitives": [
        "terms_change"
      ]
    }
  ],
