	# With Mynt Studio on this domain (install-host.sh --studio-upstream). For every request on the
	# site, Mynt's paths included: a caller's own X-Mynt-Client-IP is removed (only this server sets
	# it, below), and responses aren't type-sniffed.
	request_header -X-Mynt-Client-IP
	header X-Content-Type-Options nosniff
	# Mynt's own paths that the blocks above don't name go to Mynt; everything else is the studio.
	# Signed event deliveries from the sign-in provider (POST /webhooks/clerk); Mynt caps them at 1 MB itself.
	@mynt_webhooks path /webhooks/*
	handle @mynt_webhooks {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:@PORT@
	}
	@mynt path /v1 /llms.txt /llms-full.txt /.well-known/* /ramp-sandbox/*
	handle @mynt {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:@PORT@
	}
	# Mynt Studio, served from its own host. It sees the caller's address only in X-Mynt-Client-IP,
	# set here, and trusts it only from this server's addresses (its TRUSTED_EDGE_IPS).
	handle {
		# The studio's host takes request bodies up to 4.5 MB.
		request_body {
			max_size 4.5MB
		}
		reverse_proxy https://@STUDIO_UPSTREAM@ {
			header_up Host @STUDIO_UPSTREAM@
			header_up X-Mynt-Client-IP {client_ip}
			# The chat streams its replies.
			flush_interval -1
			transport http {
				tls_server_name @STUDIO_UPSTREAM@
			}
		}
	}
}
