# Mynt MCP server. Installed by deploy/host/install-host.sh into /etc/caddy-companion/sites/.
@DOMAIN@ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /mcp* {
		reverse_proxy 127.0.0.1:@PORT@
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:@PORT@
	}
	# Runtime API for developers' apps (app API keys, not Clerk).
	handle /v1/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:@PORT@
	}
	# Build agents' model calls, proxied by Mynt with per-build tokens.
	handle /agent/* {
		request_body {
			max_size 32MB
		}
		reverse_proxy 127.0.0.1:@PORT@ {
			flush_interval -1
		}
	}
	# One-click opt-out links in the connector's messages.
	handle /bd/* {
		reverse_proxy 127.0.0.1:@PORT@
	}
	# OAuth discovery for MCP clients (sign-in is with Clerk).
	handle /.well-known/oauth-* {
		reverse_proxy 127.0.0.1:@PORT@
	}
	# Everything else (/, /llms.txt, /llms-full.txt, /.well-known/llms.txt and real 404s) is Mynt's to answer.
	handle {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:@PORT@
	}
}
