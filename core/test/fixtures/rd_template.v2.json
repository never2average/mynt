{
  "_id": "recurring-deposit-template",
  "product_name": "Recurring Deposit (template)",
  "product_type": "deposits",
  "descriptions": {
    "summary": "Fixed monthly instalments collected by recurring debit mandate into a term deposit that pays a rate fixed at booking.",
    "key_features": [
      "Fixed monthly instalment collected automatically",
      "Rate fixed for the whole tenor",
      "Reduced rate on premature closure"
    ]
  },
  "owner_entity_id": null,
  "version": 1,
  "access_mode": "open",
  "plane": {
    "role": "template",
    "sellable": false
  },
  "context": {
    "currencies": [
      "INR"
    ],
    "calendar": "in_banking",
    "business_day_convention": "following",
    "day_count": "actual_365_fixed",
    "time_zone": "Asia/Kolkata"
  },
  "components": [
    {
      "key": "deposit",
      "country": "in",
      "primitive": "account_operations",
      "action": "issuance",
      "underlying": "cash",
      "block": "recurring_term_deposit",
      "terms": {
        "instalment_amount": {
          "$term": "instalment_amount"
        },
        "tenor_months": {
          "$term": "tenor_months"
        },
        "maturity_date": {
          "$term": "maturity_date"
        }
      },
      "schedules": [
        {
          "purpose": "interest_posting",
          "anchor": "first_instalment_date",
          "cycle": "P3M",
          "end": {
            "$term": "maturity_date"
          },
          "day_basis": "calendar"
        },
        {
          "purpose": "maturity",
          "anchor": {
            "$term": "maturity_date"
          },
          "business_day_convention": "following"
        }
      ]
    },
    {
      "key": "mandate",
      "country": "in",
      "primitive": "payments",
      "action": "sale",
      "block": "mandate",
      "terms": {
        "mandate_type": "recurring_debit",
        "amount": {
          "$term": "instalment_amount"
        },
        "debit_day": {
          "$term": "debit_day"
        },
        "source": "customer_bank_account"
      },
      "schedules": [
        {
          "purpose": "mandate_debit",
          "anchor": "first_instalment_date",
          "cycle": {
            "$term": "instalment_cycle"
          },
          "count": {
            "$term": "tenor_months"
          },
          "day_basis": "business",
          "business_day_convention": "following"
        }
      ]
    }
  ],
  "customer_segments": [
    {
      "_id": "retail_saver",
      "name": "Resident adult savers",
      "customer_kind": "individual",
      "qualification": {
        "min_age": 18,
        "resident": true
      },
      "identity": {
        "verification_tiers": [
          {
            "tier": "full_kyc",
            "methods": [
              "ekyc",
              "video_kyc",
              "in_person"
            ]
          }
        ],
        "min_tier_by_event": {
          "onboarding": "full_kyc"
        }
      },
      "fraud": {
        "product_risk": "low",
        "channel_risk": "low",
        "monitoring": [
          "post_event"
        ]
      },
      "target_market": {
        "client_type": "retail",
        "knowledge_experience": "basic",
        "loss_capacity": "none",
        "risk_tolerance": "conservative",
        "objectives": [
          "regular_saving"
        ],
        "holding_period": "P1Y"
      },
      "channels": [
        "app",
        "web",
        "branch"
      ]
    },
    {
      "_id": "senior_saver",
      "name": "Senior citizen savers",
      "customer_kind": "individual",
      "qualification": {
        "min_age": 60,
        "resident": true
      },
      "identity": {
        "verification_tiers": [
          {
            "tier": "full_kyc",
            "methods": [
              "ekyc",
              "video_kyc",
              "in_person"
            ]
          }
        ],
        "min_tier_by_event": {
          "onboarding": "full_kyc"
        }
      },
      "fraud": {
        "product_risk": "low",
        "channel_risk": "low",
        "monitoring": [
          "post_event"
        ]
      },
      "target_market": {
        "client_type": "retail",
        "knowledge_experience": "basic",
        "loss_capacity": "none",
        "risk_tolerance": "conservative",
        "objectives": [
          "regular_saving",
          "income_in_retirement"
        ],
        "holding_period": "P1Y"
      },
      "channels": [
        "app",
        "branch"
      ]
    }
  ],
  "core_algorithms": [
    {
      "_id": "rd_interest",
      "algorithm_name": "Recurring deposit interest and premature-closure calculator",
      "description": "Quarterly compounding on each instalment from its credit date; recomputes at the reduced rate on premature closure",
      "purpose": "interest_calculation",
      "repository": "models/rd-interest",
      "version": "1.2.0"
    }
  ],
  "risk_models": [],
  "partner_handoffs": [],
  "terms": [
    {
      "_id": "instalment_amount",
      "type": "money",
      "currency": "INR",
      "default": 1000,
      "range": {
        "min": 100,
        "max": 1000000,
        "step": 10
      },
      "set_by": [
        "template",
        "jurisdiction_variant",
        "customer"
      ],
      "negotiable": "customer_choice",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "tenor_months",
      "type": "integer",
      "unit": "months",
      "default": 12,
      "range": {
        "min": 6,
        "max": 120,
        "step": 3
      },
      "set_by": [
        "template",
        "jurisdiction_variant",
        "customer"
      ],
      "negotiable": "customer_choice",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "instalment_cycle",
      "type": "cycle",
      "default": "P1M",
      "allowed": [
        "P1M"
      ],
      "set_by": [
        "template"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "debit_day",
      "type": "integer",
      "default": 5,
      "range": {
        "min": 1,
        "max": 28,
        "step": 1
      },
      "set_by": [
        "template",
        "customer"
      ],
      "negotiable": "customer_choice",
      "post_issue": {
        "rule": "customer_dated_change",
        "notice": "P5D",
        "max_changes": 2,
        "event": "mandate_amended"
      }
    },
    {
      "_id": "deposit_rate",
      "type": "rate",
      "unit": "pct_pa",
      "default": 6.5,
      "range": {
        "min": 0,
        "max": 15
      },
      "set_by": [
        "template",
        "jurisdiction_variant"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      },
      "effective_dated": true
    },
    {
      "_id": "rate_spread_bps",
      "type": "integer",
      "unit": "bps",
      "default": 0,
      "range": {
        "min": 0,
        "max": 100
      },
      "set_by": [
        "template",
        "segment_override",
        "promotional_overlay"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "premature_rate_cut_bps",
      "type": "integer",
      "unit": "bps",
      "default": 100,
      "range": {
        "min": 0,
        "max": 200
      },
      "set_by": [
        "template",
        "jurisdiction_variant"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    },
    {
      "_id": "missed_instalment_fee",
      "type": "money",
      "currency": "INR",
      "default": 0,
      "range": {
        "min": 0,
        "max": 500
      },
      "set_by": [
        "template",
        "jurisdiction_variant"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "operations_dated_change",
        "notice": "P30D"
      }
    },
    {
      "_id": "maturity_date",
      "type": "date",
      "derived": "add_months(first_instalment_date, tenor_months)",
      "set_by": [
        "template"
      ],
      "negotiable": "fixed",
      "post_issue": {
        "rule": "immutable"
      }
    }
  ],
  "rates": [
    {
      "_id": "deposit_rate",
      "kind": "deposit",
      "rate_type": "fixed",
      "value": {
        "$term": "deposit_rate"
      },
      "spread": {
        "$term": "rate_spread_bps"
      },
      "day_count": "actual_365_fixed",
      "compounding": "P3M",
      "application": "maturity"
    }
  ],
  "fees": [
    {
      "_id": "missed_instalment_fee",
      "type": "DISHONOUR",
      "method": "fixed",
      "amount": {
        "$term": "missed_instalment_fee"
      },
      "payer": "customer",
      "tax": [
        "in_gst"
      ]
    }
  ],
  "limits": [
    {
      "_id": "max_open_rds",
      "kind": "constraint",
      "constraint_type": "MAX_ACCOUNTS",
      "max": 10,
      "scope": "customer"
    },
    {
      "_id": "debit_equals_instalment",
      "kind": "control",
      "event_stream": "mandate_debit",
      "rule_type": "conditional",
      "conditions": [
        {
          "attr": "txn.amount",
          "op": "ne",
          "value": {
            "$term": "instalment_amount"
          }
        }
      ],
      "scope": "account",
      "outcome": "decline",
      "purpose": "policy",
      "state": "active"
    }
  ],
  "servicing_policies": [
    {
      "_id": "early_withdrawal",
      "kind": "early_withdrawal",
      "config": {
        "allowed": "with_penalty",
        "penalty_rate_reduction": {
          "$term": "premature_rate_cut_bps"
        },
        "partial": false
      }
    },
    {
      "_id": "missed_instalments",
      "kind": "missed_instalments",
      "config": {
        "max_consecutive": 6,
        "on_breach": "close_and_pay_out"
      }
    },
    {
      "_id": "maturity",
      "kind": "maturity",
      "config": {
        "instructions": [
          "pay_out",
          "renew_principal_and_interest"
        ],
        "default_instruction": "pay_out",
        "payout_to": "linked_account"
      }
    }
  ],
  "lifecycle_events": [
    {
      "_id": "mandate_registered",
      "sequence": 1,
      "trigger": "customer",
      "primitives": [
        "contract_formation"
      ]
    },
    {
      "_id": "account_opened",
      "actus": "IED",
      "sequence": 1,
      "trigger": "customer",
      "primitives": [
        "contract_formation",
        "execution"
      ],
      "edition": "latest"
    },
    {
      "_id": "mandate_debit_succeeded",
      "sequence": 4,
      "trigger": "scheduled",
      "primitives": [
        "transfer"
      ]
    },
    {
      "_id": "instalment_credited",
      "actus": "PD",
      "sequence": 4,
      "trigger": "linked",
      "primitives": [
        "quantity_change"
      ]
    },
    {
      "_id": "mandate_debit_failed",
      "sequence": 6,
      "trigger": "condition"
    },
    {
      "_id": "interest_capitalised",
      "actus": "IPCI",
      "sequence": 9,
      "trigger": "scheduled",
      "primitives": [
        "quantity_change"
      ]
    },
    {
      "_id": "mandate_amended",
      "sequence": 11,
      "trigger": "customer",
      "primitives": [
        "terms_change"
      ],
      "edition": "stored"
    },
    {
      "_id": "premature_closure",
      "actus": "TD",
      "sequence": 16,
      "trigger": "customer",
      "primitives": [
        "terms_change",
        "quantity_change"
      ],
      "edition": "stored"
    },
    {
      "_id": "matured",
      "actus": "MD",
      "sequence": 19,
      "trigger": "scheduled",
      "primitives": [
        "quantity_change",
        "transfer"
      ]
    },
    {
      "_id": "mandate_cancelled",
      "sequence": 19,
      "trigger": "linked",
      "primitives": [
        "terms_change"
      ]
    }
  ],
  "invariants": [
    {
      "_id": "mandate_ends_by_maturity",
      "expr": "mandate.last_debit_date <= deposit.maturity_date",
      "applies_at": [
        "design",
        "origination"
      ]
    },
    {
      "_id": "same_currency",
      "expr": "mandate.currency == deposit.currency",
      "applies_at": [
        "design"
      ]
    }
  ],
  "connections": [
    {
      "_id": "mandate_funds_deposit",
      "type": "funds",
      "from": {
        "kind": "component",
        "id": "mandate"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "amount_rule": "from_term",
        "amount": {
          "$term": "instalment_amount"
        },
        "schedule_purpose": "mandate_debit",
        "count": {
          "$term": "tenor_months"
        },
        "shares": [
          "currency",
          "instalment_amount"
        ],
        "failure_handling": {
          "retries": 1,
          "retry_after": "P3D",
          "on_exhaustion": "raise_event",
          "event": "mandate_debit_failed"
        }
      }
    },
    {
      "_id": "retail_is_depositor",
      "type": "segment_maps_to_persona",
      "from": {
        "kind": "customer_segment",
        "id": "retail_saver"
      },
      "to": {
        "kind": "register_persona",
        "regulator_id": "in-rbi",
        "id": "in-rbi_retail_depositor"
      },
      "attributes": {
        "fit": "subset"
      }
    },
    {
      "_id": "senior_is_depositor",
      "type": "segment_maps_to_persona",
      "from": {
        "kind": "customer_segment",
        "id": "senior_saver"
      },
      "to": {
        "kind": "register_persona",
        "regulator_id": "in-rbi",
        "id": "in-rbi_senior_citizen_depositor"
      },
      "attributes": {
        "fit": "whole_persona"
      }
    },
    {
      "_id": "retail_interest",
      "type": "segment_uses_algorithm",
      "from": {
        "kind": "customer_segment",
        "id": "retail_saver"
      },
      "to": {
        "kind": "core_algorithm",
        "id": "rd_interest"
      },
      "attributes": {
        "stage": "servicing"
      }
    },
    {
      "_id": "senior_interest",
      "type": "segment_uses_algorithm",
      "from": {
        "kind": "customer_segment",
        "id": "senior_saver"
      },
      "to": {
        "kind": "core_algorithm",
        "id": "rd_interest"
      },
      "attributes": {
        "stage": "servicing"
      }
    },
    {
      "_id": "t_instalment",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "instalment_amount"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_tenor",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "tenor_months"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_cycle",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "instalment_cycle"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_debit_day",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "debit_day"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_rate",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "deposit_rate"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_spread",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "rate_spread_bps"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_spread_senior",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "rate_spread_bps"
      },
      "to": {
        "kind": "customer_segment",
        "id": "senior_saver"
      },
      "attributes": {
        "mode": "override",
        "override": {
          "default": 50
        }
      }
    },
    {
      "_id": "t_premature",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "premature_rate_cut_bps"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_missed_fee",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "missed_instalment_fee"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "t_maturity",
      "type": "applies_to",
      "from": {
        "kind": "term",
        "id": "maturity_date"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "r_deposit",
      "type": "applies_to",
      "from": {
        "kind": "rate",
        "id": "deposit_rate"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "f_missed",
      "type": "applies_to",
      "from": {
        "kind": "fee",
        "id": "missed_instalment_fee"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "l_max_rds",
      "type": "applies_to",
      "from": {
        "kind": "limit",
        "id": "max_open_rds"
      },
      "to": {
        "kind": "product",
        "id": "self"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "l_debit",
      "type": "applies_to",
      "from": {
        "kind": "limit",
        "id": "debit_equals_instalment"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "s_early",
      "type": "applies_to",
      "from": {
        "kind": "servicing_policy",
        "id": "early_withdrawal"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "s_missed",
      "type": "applies_to",
      "from": {
        "kind": "servicing_policy",
        "id": "missed_instalments"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "s_maturity",
      "type": "applies_to",
      "from": {
        "kind": "servicing_policy",
        "id": "maturity"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "mode": "default"
      }
    },
    {
      "_id": "e1",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "mandate_registered"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      }
    },
    {
      "_id": "e2",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "account_opened"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      }
    },
    {
      "_id": "e3",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "mandate_debit_succeeded"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      },
      "attributes": {
        "schedule_purpose": "mandate_debit"
      }
    },
    {
      "_id": "e4",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "instalment_credited"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      }
    },
    {
      "_id": "e5",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "mandate_debit_failed"
      },
      "to": {
        "kind": "component",
        "id": "mandate"
      }
    },
    {
      "_id": "e6",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "interest_capitalised"
      },
      "to": {
        "kind": "component",
        "id": "deposit"
      },
      "attributes": {
        "schedule_purpose": "interest_posting"
      }
    },
    {
      "_id": "e7",
      "type": "occurs_on",
      "from": {
        "kind": "lifecycle_event",
        "id": "mandate_amended"
      },
