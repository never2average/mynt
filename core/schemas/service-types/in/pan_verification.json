{
  "region": "IN",
  "key": "pan_verification",
  "name": "PAN verification",
  "category": "identity",
  "moves_money": false,
  "description": "Checks a Permanent Account Number against the Income Tax Department's records, and whether the name and date of birth given match it. Online PAN verification is open to entities the Income Tax Department authorises, which isn't a licence in the financial regulatory model.",
  "input_schema": {
    "type": "object",
    "required": [
      "pan"
    ],
    "properties": {
      "pan": {
        "type": "string",
        "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$"
      },
      "full_name": {
        "type": "string"
      },
      "date_of_birth": {
        "type": "string",
        "format": "date"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "pan_status"
    ],
    "properties": {
      "pan_status": {
        "enum": [
          "valid",
          "invalid",
          "deactivated",
          "deleted",
          "not_found"
        ]
      },
      "name_match": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "dob_match": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "additionalProperties": false
  },
  "consent_purpose": "identity_verification",
  "fills": [],
  "innovator_licences": [],
  "vendor_licences": [],
  "client_result": {
    "status": {
      "from": "pan_status",
      "map": {
        "valid": "verified",
        "invalid": "not_verified",
        "deactivated": "not_verified",
        "deleted": "not_verified",
        "not_found": "not_verified"
      }
    },
    "fields": [],
    "redirect": false
  }
}
