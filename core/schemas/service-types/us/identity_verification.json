{
  "region": "US",
  "key": "identity_verification",
  "name": "Identity and SSN verification",
  "category": "identity",
  "moves_money": false,
  "description": "Checks that a name, date of birth and Social Security number belong together, with the customer's consent (as the Social Security Administration's electronic verification requires).",
  "input_schema": {
    "type": "object",
    "required": [
      "full_name",
      "date_of_birth",
      "ssn"
    ],
    "properties": {
      "full_name": {
        "type": "string"
      },
      "date_of_birth": {
        "type": "string",
        "format": "date"
      },
      "ssn": {
        "type": "string",
        "pattern": "^[0-9]{3}-?[0-9]{2}-?[0-9]{4}$"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "result"
    ],
    "properties": {
      "result": {
        "enum": [
          "match",
          "no_match",
          "deceased",
          "unavailable"
        ]
      },
      "residential_state": {
        "type": "string",
        "pattern": "^us-[a-z]{2}$",
        "description": "The US state of the residential address this check verified, as ISO 3166-2 (e.g. us-ny). Send it only when the check verified the address, and only with result match: a live money movement goes by it."
      }
    },
    "additionalProperties": false
  },
  "consent_purpose": "identity_verification",
  "fills": [],
  "innovator_licences": [],
  "vendor_licences": [],
  "client_result": {
    "status": {
      "from": "result",
      "map": {
        "match": "verified",
        "no_match": "not_verified",
        "deceased": "not_verified",
        "unavailable": "failed"
      }
    },
    "fields": [],
    "redirect": false
  }
}
