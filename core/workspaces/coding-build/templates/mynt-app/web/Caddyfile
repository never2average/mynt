{
	admin off
	auto_https off
	storage file_system /tmp/caddy
}

:8080 {
	handle /api/* {
		reverse_proxy api:3000
	}
	# Mynt's client API only: client sessions, never the app key. Hosted on Mynt, anything this server sends to
	# Mynt's other routes would carry the app's key (added on the way out), so nothing else is forwarded.
	handle /v1/client/* {
		reverse_proxy {$MYNT_API_ORIGIN} {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
	}
}
