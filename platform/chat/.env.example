# Copy to .env.local and fill in. Never commit real values.

# Mynt's MCP endpoint. Sign-in uses the OAuth metadata Mynt publishes there.
MYNT_MCP_URL=https://mynt.example.com/mcp

# This app's public URL (OAuth redirects go to $APP_URL/api/auth/callback).
APP_URL=http://localhost:3000

# Scopes to ask for (defaults to the scopes Mynt advertises).
# MYNT_OAUTH_SCOPE=openid profile email

# Claude through Google Vertex AI (used when ANTHROPIC_API_KEY is not set).
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=global
# Path to a service-account key; or leave unset to use the machine's default Google credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Or Claude through the Claude API instead of Vertex:
# ANTHROPIC_API_KEY=

# Model for the chat, and (Vertex only) the model to retry on if a request is declined.
CHAT_MODEL=claude-opus-5-5
# CHAT_FALLBACK_MODEL=claude-opus-4-8

# Chat messages each Mynt user may send per day (UTC), so open sign-up can't run up the model bill.
# 0 turns the cap off. Kept in memory: run a single instance.
CHAT_DAILY_MESSAGES=50
