{
  "name": "mynt-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Mynt: the MCP server (core/, installed on its own from its own lockfile) and the apps built on it (platform/, npm workspaces)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "platform/*",
    "platform/packages/*"
  ],
  "scripts": {
    "build": "npm --prefix core run build",
    "test": "npm --prefix core test"
  },
  "overrides": {
    "@assistant-ui/core": "0.1.1",
    "@assistant-ui/store": "0.2.1",
    "@assistant-ui/tap": "0.5.1"
  }
}
