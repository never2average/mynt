{
  "name": "mynt-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Mynt: the MCP server (core/) and the apps built on it (platform/), as npm workspaces",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "core",
    "platform/*",
    "platform/packages/*"
  ],
  "scripts": {
    "build": "npm run build -w core",
    "test": "npm test -w core"
  },
  "overrides": {
    "@assistant-ui/core": "0.1.1",
    "@assistant-ui/store": "0.2.1",
    "@assistant-ui/tap": "0.5.1"
  }
}
